# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

PORT=5000
NODE_ENV=development

# Frontend URL allowed by CORS (Vite default)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# If your password has special characters (@ : / ? # %), URL-encode them.
# Example: mongodb://127.0.0.1:27017/sahyog_db or mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sahyog_db

# JWT Authentication
JWT_SECRET=sahyog_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Default Administrator Seed
ADMIN_EMAIL=admin@sahyog.org
ADMIN_PASSWORD=Admin@123
